# =====================================================================
# FilmLink backend - MAU bien moi truong. Chep thanh .env (cung thu muc) roi dien gia tri cua ban.
# .env KHONG duoc commit (.gitignore da chan). File mau nay KHONG chua mat khau.
#
# Dinh dang: KEY=VALUE, moi dong mot bien.
#   - KHONG dung dau nhay:        DB_PASSWORD=abc123   (dung)
#                                 DB_PASSWORD="abc123" (sai - dau nhay thanh mot phan mat khau)
#   - Dong bat dau bang # la ghi chu.
#   - Neu mat khau co dau \ thi viet thanh \\
# Bien moi truong cua Windows (setx) neu co se DE LEN gia tri trong file nay.
# =====================================================================

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/postgres

# Schema trong database tren. Flyway tu tao neu chua co.
# App chay tren DB_SCHEMA; test (mvnw verify) chay tren DB_TEST_SCHEMA - tach rieng de test khong dung du lieu dev.
DB_SCHEMA=filmlink_local
DB_TEST_SCHEMA=filmlink_test
DB_USERNAME=postgres
DB_PASSWORD=

# --- Swagger (true o local, false khi deploy) ---
SWAGGER_ENABLED=true

# --- Server ---
# SERVER_PORT=8386

# --- JWT (UC01, NFR-SEC-01) ---
# BAT BUOC. Khoa HS256 dang Base64, toi thieu 256 bit (32 byte). Moi may tu sinh, KHONG dung chung, KHONG commit.
# Sinh bang PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=
# Thoi han token (ISO-8601 Duration). Mac dinh: access 15 phut, refresh 7 ngay.
# JWT_ACCESS_TOKEN_TTL=PT15M
# JWT_REFRESH_TOKEN_TTL=P7D

# --- Email ---
# log = chi ghi email (ke ca OTP) ra log, dung o may local. Chua co provider SMTP.
MAIL_PROVIDER=log

# --- CORS: origin FE duoc goi API, phan tach dau phay ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- VNPay sandbox (SPIKE, chua noi Service Order) ---
# De trong thi POST /api/v1/payments/vnpay/sandbox-url tra 503; app van khoi dong.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
